# Frontend public environment variables
# Copy this file to .env.local for local development.
#
# Only values with the VITE_ prefix are exposed to the browser.
# Never place service_role keys, Asaas keys, Brevo keys, Stripe secrets,
# webhook tokens, or other private credentials in VITE_ variables.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional public app metadata
VITE_APP_NAME="FestaAI"
VITE_APP_ENV="development"

# Supabase — dev local / CLI (never commit real keys)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Asaas SANDBOX — desenvolvimento local (painel: sandbox.asaas.com)
ASAAS_SANDBOX_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_SANDBOX_API_KEY=""
ASAAS_SANDBOX_WEBHOOK_TOKEN=""

# Ativas localmente — edge functions locais leem ASAAS_*
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# Asaas PRODUÇÃO — referência para sync no Supabase (não usar localmente)
ASAAS_PRODUCTION_API_URL="https://api.asaas.com/v3"
ASAAS_PRODUCTION_API_KEY=""
ASAAS_PRODUCTION_WEBHOOK_TOKEN=""

# Brevo — sync no Supabase
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="FestaAI"
BREVO_REPLY_TO_EMAIL=""

APP_BASE_URL="https://festaai.com.br"
APP_URL="https://festaai.com.br"

# Reajuste anual da mensalidade (IPCA via BCB; override opcional)
# BILLING_ANNUAL_ADJUSTMENT_RATE=0.0482
# BILLING_ANNUAL_ADJUSTMENT_FALLBACK_RATE=0
# BILLING_ANNUAL_ADJUSTMENT_CRON_SECRET=""
